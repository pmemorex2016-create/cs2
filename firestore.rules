rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'ogcshop2020@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Validation helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      // Allow public read so stats and profiles work for guests
      allow read: if true;
      allow write: if isOwner(userId);

      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if isOwner(userId);
      }
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();

      // Topics within category
      match /topics/{topicId} {
        allow read: if true;
        allow create: if isSignedIn() 
          && request.resource.data.authorId == request.auth.uid
          && isValidId(topicId);
        allow update: if isSignedIn() && (
          isOwner(resource.data.authorId)
          || isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'viewCount', 'updatedAt'])
        );
        allow delete: if isAdmin();

        // Posts within topic
        match /posts/{postId} {
          allow read: if true;
          allow create: if isSignedIn() 
            && request.resource.data.authorId == request.auth.uid
            && isValidId(postId);
          allow update: if isOwner(resource.data.authorId) || isAdmin();
          allow delete: if isAdmin();
        }
      }
    }
  }
}
